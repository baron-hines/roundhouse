# Framework Ruby unit-test runner.
#
# Usage:
#   rake -f runtime/ruby/Rakefile test
#   ruby runtime/ruby/test/active_record/<thing>_test.rb   # one file
#
# Tests run under stock CRuby — no spinel, no transpile, no app
# fixture. Runs the framework tests as a single Minitest process,
# except the Active Support differential, which runs in isolation so
# Rails' I18n loads before the framework's I18n shim. CI gates this
# before any target's transpile.

require "rake/testtask"

Rake::TestTask.new(:framework_test_suite) do |t|
  t.libs << "."
  t.libs << "test"
  t.test_files = FileList["test/**/*_test.rb"].exclude("test/active_support_inflections_test.rb")
  t.warning = false
  t.verbose = false
end

task :active_support_inflections do
  sh RbConfig.ruby, "-Itest", "test/active_support_inflections_test.rb"
end

task test: [:framework_test_suite, :active_support_inflections]
task default: :test
