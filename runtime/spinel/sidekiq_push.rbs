# Typing for runtime/spinel/sidekiq_push.rb.
module SidekiqPush
  URL: Array[String]
  URL_PID: Array[Integer]
  RECORDING: Array[bool]
  RECORDED: Array[String]

  class HeldPush
    def initialize: (String job_class, String queue, Float at, String aj_json) -> void
    def job_class: () -> String
    def queue: () -> String
    def at: () -> Float
    def aj_json: () -> String
  end

  def self.enqueue: (String job_class, String queue, Float at, String aj_json) -> nil
  class HeldNative
    def initialize: (String job_class, String retry_json, String queue, String extra, String args_json) -> void
    def job_class: () -> String
    def retry_json: () -> String
    def queue: () -> String
    def extra: () -> String
    def args_json: () -> String
  end

  def self.enqueue_native: (String job_class, String retry_json, String queue, String extra, Float at, bool class_side, String args_json) -> nil
  def self.native_value: (String | Integer | Float | bool | nil value) -> String
  def self.bulk_begin: (Integer limit) -> nil
  def self.bulk_end: () -> nil
  def self.bulk_limit: () -> Array[Integer]
  def self.bulk: () -> Array[SidekiqPush::HeldNative]
  def self.flush_bulk: () -> nil
  def self.push_many: (String queue, Array[String] jsons) -> nil
  def self.enqueue_after_commit: (String job_class, String queue, Float at, String aj_json) -> nil
  def self.held: () -> Array[SidekiqPush::HeldPush]
  def self.flush_held: () -> nil
  def self.drop_held: () -> nil
  def self.push: (String queue, String json) -> nil
  def self.schedule: (Float at, String json) -> nil
  def self.now_ms: () -> Integer
  def self.url: () -> String
  def self.resolve_url: () -> String
  def self.password: () -> String
  def self.setting: (String name) -> String
  def self.setting_or: (String name, String default) -> String
  def self.required_setting: (String name) -> String
  def self.redacted_url: (String value) -> String
  def self.announce: () -> nil
  def self.start_recording: () -> nil
  def self.stop_recording: () -> nil
  def self.recorded: () -> Array[String]
end
